# This repository publishes to BOTH registries from one tree:
#
#   npm       @coolms/document-engine   the TypeScript layout engine
#   Packagist coolms/document-fonts     the font files it measures
#
# A PHP application needs the fonts and can do nothing with the engine, so
# the composer archive is assets/fonts and the documents that explain it.
# Everything else is excluded -- including tools/, which is developer
# probes in JavaScript and Python and has no business in a package a PHP
# project downloads.
#
# ⚠️ export-ignore affects the ARCHIVE ONLY. Everything below stays in git
# and stays in the npm package, which has its own `files` list.
src/                 export-ignore
dist/                export-ignore
tests/               export-ignore
test/                export-ignore
tools/               export-ignore
.github/             export-ignore
package.json         export-ignore
package-lock.json    export-ignore
tsconfig.json        export-ignore
tsconfig.build.json  export-ignore
vitest.config.ts     export-ignore
eslint.config.mjs    export-ignore
.gitignore           export-ignore
.gitattributes       export-ignore
